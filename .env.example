# --- Typesense ---
NUXT_TYPESENSE_URL=http://localhost:8108
# used by the typesense container AND the app
TYPESENSE_API_KEY=change-me-something-random
NUXT_TYPESENSE_API_KEY=change-me-something-random

# --- RAG answers (LLM) ---
# Any OpenAI-compatible /v1/chat/completions endpoint. Typesense calls it for you
# and strips the platform prefix, so use the plain model name.
# Leave NUXT_LLM_MODEL empty to disable the chat (search keeps working).
# NOTE: Typesense enforces a hard 60s timeout per LLM call — pick a model that
# answers within that.
NUXT_LLM_URL=<your-provider-url>/v1
NUXT_LLM_MODEL=<your-model>
NUXT_LLM_API_KEY=<your-key>

# --- Embeddings ---
# Default: Typesense built-in model (ts/e5-small), downloaded automatically, no API key.
# For external embeddings set: NUXT_EMBEDDING_MODEL=<your-model> NUXT_EMBEDDING_URL=<your-provider-url>/v1 NUXT_EMBEDDING_API_KEY=<your-key>
# NOTE: switching models requires recreating the typesense collections (drop data volume or delete collections).
NUXT_EMBEDDING_MODEL=ts/e5-small
#NUXT_EMBEDDING_URL=
#NUXT_EMBEDDING_API_KEY=

# Optional overrides
#NUXT_CONTENT_DIR=content
#NUXT_DATA_DIR=data